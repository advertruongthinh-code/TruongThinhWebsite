{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Website: Localhost Trường Thịnh",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "detail": "Chạy localhost; dùng Tasks: Terminate Task hoặc nút dừng của terminal để dừng."
    },
    {
      "label": "Demo: Deploy Cloudflare (main)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-Command",
        "$ErrorActionPreference = 'Stop'; if ((git rev-parse --abbrev-ref HEAD) -ne 'main') { throw 'Chuyển sang nhánh main trước khi deploy.' }; if (git status --porcelain --untracked-files=no) { throw 'Còn thay đổi chưa commit; commit hoặc stash trước.' }; git pull --ff-only origin main; if ($LASTEXITCODE) { exit $LASTEXITCODE }; pnpm install --frozen-lockfile; if ($LASTEXITCODE) { exit $LASTEXITCODE }; pnpm deploy:demo; exit $LASTEXITCODE"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "Owner deploy tay demo từ main mới nhất khi CI deploy kẹt; cần đăng nhập Cloudflare một lần bằng: pnpm demo:wrangler login."
    },
    {
      "label": "Tooling: Watch",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Graphify: Watch"
      ],
      "problemMatcher": []
    },
    {
      "label": "Graphify: Watch",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\tooling\\watch-graphify.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Graphify: Install Git Hooks",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\tooling\\graphify-git-hooks.ps1", "-Action", "install"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Tooling: Doctor",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\tooling\\doctor.ps1", "-Mcp"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
