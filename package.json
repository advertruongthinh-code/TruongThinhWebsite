{
  "name": "truong-thinh-project-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Truong Thinh Website with portable project policy and pinned browser QA",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "prepare:site": "node scripts/site/prepare-static-assets.mjs",
    "dev": "pnpm prepare:site && node scripts/tooling/serve-static-parity.mjs --port 8787",
    "deploy:demo": "pnpm prepare:site && pnpm demo:wrangler deploy --config wrangler.static.toml",
    "demo:wrangler": "pnpm dlx --allow-build=esbuild --allow-build=workerd wrangler@4.124.0",
    "qa:static": "node tests/site/site-static-contract.cjs",
    "qa:related-scroll": "node tests/site/related-scroll-device.mjs",
    "qa:release-regressions": "node --test --test-concurrency=1 tests/site/static-locales.test.mjs tests/site/advertising-full-span-p72.e2e.mjs tests/site/advertising-no-titles.e2e.mjs tests/site/advertising-suggestion-conditional.e2e.mjs tests/site/advertising-suggestion-info.e2e.mjs tests/site/shared-header-bottom-p7-1.e2e.mjs tests/site/shared-header-single-line.e2e.mjs",
    "qa:client-assets": "node tests/site/client-logo-assets-contract.cjs",
    "qa:worker:static": "node tests/worker/worker-static-contract.cjs",
    "qa:worker:security": "node tests/worker/worker-contract.cjs --security-only",
    "qa:site": "node tests/site/site.e2e.cjs",
    "qa:worker": "node tests/worker/worker-contract.cjs",
    "qa:cross-browser": "playwright test tests/site/cross-browser.smoke.spec.cjs",
    "tooling:bootstrap": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/tooling/bootstrap.ps1",
    "tooling:doctor": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/tooling/doctor.ps1",
    "tooling:skills": "node scripts/tooling/vendor-skills.mjs",
    "tooling:skills:check": "node scripts/tooling/vendor-skills.mjs --check"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lazysizes": "5.3.2",
    "masonry-layout": "4.2.2",
    "swiper": "14.2.0"
  }
}
