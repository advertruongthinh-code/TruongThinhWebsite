{
  "description": "Serialized project tooling hooks: ADHD, Serena, Graphify and Impeccable.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\".tooling/runtimes/powershell-7.6.4/pwsh.exe\" -NoProfile -ExecutionPolicy Bypass -File \"scripts/tooling/hook-dispatch.ps1\" -Event SessionStart",
            "timeout": 120,
            "statusMessage": "Loading project tooling",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__serena__.*|mcp__graphify__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\".tooling/runtimes/powershell-7.6.4/pwsh.exe\" -NoProfile -ExecutionPolicy Bypass -File \"scripts/tooling/hook-dispatch.ps1\" -Event PreToolUse",
            "timeout": 120,
            "statusMessage": "Checking project tool state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\".tooling/runtimes/powershell-7.6.4/pwsh.exe\" -NoProfile -ExecutionPolicy Bypass -File \"scripts/tooling/hook-dispatch.ps1\" -Event PostToolUse",
            "timeout": 180,
            "statusMessage": "Tracking project file changes",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\".tooling/runtimes/powershell-7.6.4/pwsh.exe\" -NoProfile -ExecutionPolicy Bypass -File \"scripts/tooling/hook-dispatch.ps1\" -Event Stop",
            "timeout": 180,
            "statusMessage": "Running final project checks",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\".tooling/runtimes/powershell-7.6.4/pwsh.exe\" -NoProfile -ExecutionPolicy Bypass -File \"scripts/tooling/hook-dispatch.ps1\" -Event SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
