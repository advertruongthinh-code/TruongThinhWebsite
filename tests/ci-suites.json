    "tests/site/advertising-photo-transitions.e2e.mjs",
    "tests/site/advertising-photo-view.e2e.mjs",
    "tests/site/advertising-primary-p14.e2e.mjs",
    "tests/site/advertising-random-browse.e2e.mjs",
    "tests/site/advertising-return-p74.e2e.mjs",
    "tests/site/advertising-reveal-offscreen.e2e.mjs",
    "tests/site/advertising-route-footer-p75.e2e.mjs",
    "tests/site/advertising-single-related.e2e.mjs",
