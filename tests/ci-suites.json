{
  "ignore": ["docs/**", "research/**", "*.md"],
  "fastOnly": [
    "AGENTS.md",
    "CLAUDE.md",
    "design-system/**",
    "scripts/docs/**",
    "tests/tooling/**",
    "src/worker/**",
    "src/admin/**",
    "src/db/**",
    "wrangler.toml",
    ".github/workflows/docs.yml",
    ".github/workflows/automerge.yml",
    ".github/workflows/deploy-demo.yml",
    ".claude/**",
    ".impeccable/**"
  ],
  "shared": [
    "src/site/motion.js",
    "src/site/style.css",
    "src/site/assets/brand/**",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "playwright.config.cjs",
    "tooling-versions.json",
    "scripts/site/**",
    "scripts/tooling/serve-static-parity.mjs",
    "scripts/ci/**",
    "tests/ci-suites.json",
    "tests/site/fixtures/**",
    "tests/site/advertising-grid-oracle.mjs",
    ".github/workflows/ci.yml"
  ],
  "suites": {
    "fast": {
      "specs": ["static-release", "cms"],
      "tests": [
        "pnpm qa:static",
        "node --test tests/tooling/*.test.mjs",
        "node scripts/site/build-image-variants.mjs --check",
        "pnpm qa:worker:security",
        "pnpm qa:client-assets",
        "node scripts/tooling/serve-static-parity.mjs --self-test",
        "node --test tests/site/*.test.mjs",
        "pnpm exec playwright test tests/site/cross-browser.smoke.spec.cjs --project=chromium"
      ]
    },
    "shell": {
      "specs": ["site-shell", "phone-header-scroll", "logo-route-crossfade", "scroll-feel", "static-release"],
      "tests": [
        "node tests/site/phone-header-scroll.e2e.mjs",
        "node tests/site/logo-route-crossfade.e2e.mjs",
        "node tests/site/not-found-routes.e2e.mjs",
        "node tests/site/shared-header-menu-route-close.e2e.mjs"
      ]
    },
    "home": { "specs": ["page-home"], "tests": [] },
    "detail-pages": { "specs": ["detail-pages"], "tests": [] },
    "adv-grid": {
      "specs": ["advertising-masonry", "advertising-skeleton", "advertising-cta-center-parallax"],
      "tests": [
        "node tests/site/advertising-skeleton-slow-network.e2e.mjs",
        "node tests/site/advertising-route-preload.e2e.mjs"
      ]
    },
    "adv-detail": { "specs": ["advertising-detail", "advertising-viewer-touch-zoom"], "tests": [] },
    "media": {
      "specs": ["media-delivery", "loading-glass-and-page-entry", "glass-surface", "media-card", "page-home", "detail-pages"],
      "tests": ["node tests/site/image-loading-frame.e2e.mjs"]
    }
  },
  "manual": {
    "tests/site/advertising-continuation.e2e.mjs": "FPS và WebGL cần GPU thật",
    "tests/site/mobile-layout-parity.e2e.mjs": "ma trận 660 ca, ba engine",
    "tests/site/mobile-viewport-stability.e2e.mjs": "ba engine, đo trên PC",
    "tests/site/scrollbar-parity.e2e.mjs": "ba engine và Chrome, Edge cài trên máy",
    "tests/site/site-media-card-playback.e2e.mjs": "phát video thật, chạy ở phiên PC"
  },
  "pending": [
    "tests/site/advertising-card-interactions.e2e.mjs",
    "tests/site/advertising-full-span-p72.e2e.mjs",
    "tests/site/advertising-hero-once.e2e.mjs",
